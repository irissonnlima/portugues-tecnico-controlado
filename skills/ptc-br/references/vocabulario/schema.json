{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/irissonnlima/portugues-tecnico-controlado/vocabulario/schema.json",
  "title": "Verbete do vocabulário controlado PTC-BR",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "lema", "classe", "status", "significado_aprovado", "versao_inclusao"],
  "properties": {
    "id": {"type": "string", "pattern": "^V-[0-9]{4}$", "description": "Estável. Nunca reutilizado."},
    "lema": {"type": "string", "minLength": 1, "description": "Forma de dicionário. Em locuções, o primeiro termo é o verbo."},
    "classe": {"enum": ["verbo", "substantivo", "adjetivo", "adverbio", "locucao_verbal", "conectivo", "padrao"]},
    "status": {"enum": ["aprovado", "nao_preferido", "proibido", "em_analise"]},
    "significado_aprovado": {"type": "string"},
    "preferir": {"type": "array", "items": {"type": "string"}, "minItems": 1,
                 "description": "Obrigatório para nao_preferido, proibido e em_analise."},
    "preferida_em_instrucoes": {"type": "string"},
    "sinonimo_de": {"type": "string", "description": "Lema do termo principal quando este é um sinônimo aceito (status aprovado). Uma camada de time pode escolher um dos dois."},
    "formas": {"type": "array", "items": {"type": "string"}, "minItems": 1,
               "description": "Substitui a flexão automática (verbos irregulares, pronominais)."},
    "padrao": {"type": "string", "description": "Expressão regular (Python, sem flags). Substitui lema e formas na detecção."},
    "flexao": {"enum": ["auto", "nenhuma"], "default": "auto"},
    "regra": {"type": "string", "pattern": "^PTC-[0-9]{2}$", "default": "PTC-25"},
    "sentidos": {
      "type": "array", "minItems": 2,
      "description": "Palavra com mais de um sentido técnico. Gera relatório para a PTC-08, não alerta.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["sentido", "dominio"],
        "properties": {
          "sentido": {"type": "string"},
          "dominio": {"type": "string"},
          "preferir": {"type": "string", "description": "Termo sem ambiguidade para este sentido."},
          "exemplo": {"type": "string"}
        }
      }
    },
    "exemplo_correto": {"type": "string"},
    "exemplo_incorreto": {"type": "string"},
    "motivo": {"type": "string"},
    "versao_inclusao": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["nao_preferido", "proibido", "em_analise"]}}},
     "then": {"required": ["preferir"]}}
  ]
}
